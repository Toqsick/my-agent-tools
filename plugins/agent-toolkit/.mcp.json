{
  "mcpServers": {
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "toqsick/github-mcp-server:develop"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "basti-tools": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PROJECT_ROOT}",
        "mcp-server-basti"
      ]
    }
  }
}
