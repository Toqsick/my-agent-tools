# =============================================================
# MCP Server Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file!
# =============================================================

# -------------------------------------------------------------
# GitHub MCP Server
# https://github.com/settings/tokens
# Scopes needed: repo, read:org, read:user
# -------------------------------------------------------------
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here

# -------------------------------------------------------------
# Gmail MCP Server
# Setup: npx @gongrzhe/server-gmail-autoauth-mcp auth
# Or via Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Enable: Gmail API
# -------------------------------------------------------------
GMAIL_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=GOCSPX-your_client_secret
GMAIL_OAUTH_REFRESH_TOKEN=1//your_refresh_token

# -------------------------------------------------------------
# Google Calendar MCP Server
# Same OAuth2 credentials as Gmail (same Google Cloud project)
# Enable: Google Calendar API
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret
GOOGLE_REFRESH_TOKEN=1//your_refresh_token

# -------------------------------------------------------------
# Filesystem MCP Server
# Absolute path to your workspace/project directory
# -------------------------------------------------------------
WORKSPACE_PATH=/Users/yourname/workspace

# -------------------------------------------------------------
# Brave Search MCP Server
# https://api.search.brave.com/app/keys
# Free tier: 2,000 queries/month
# -------------------------------------------------------------
BRAVE_API_KEY=BSA_your_brave_api_key

# -------------------------------------------------------------
# Memory MCP Server
# Path where agent memory/knowledge graph is stored
# -------------------------------------------------------------
MEMORY_FILE_PATH=~/.agent-memory/memory.json

# -------------------------------------------------------------
# Optional: Puppeteer / Browser Automation
# No API key needed - headless Chrome is used automatically
# Set to 'true' to run browser in visible mode (for debugging)
# -------------------------------------------------------------
PUPPETEER_HEADLESS=true

# =============================================================
# QUICK SETUP GUIDE
# =============================================================
# 1. cp .env.example .env
# 2. Fill in GITHUB_PERSONAL_ACCESS_TOKEN
# 3. For Gmail + Calendar:
#    a) Go to https://console.cloud.google.com
#    b) Create project > Enable Gmail API + Calendar API
#    c) Create OAuth2 credentials (Desktop App)
#    d) Run: npx @gongrzhe/server-gmail-autoauth-mcp auth
#    e) Paste the generated tokens above
# 4. For Brave Search:
#    a) Go to https://api.search.brave.com
#    b) Sign up > Create API Key
# 5. Restart your MCP client (Claude Desktop / Cursor etc.)
# =============================================================
